{
  "framework": null,
  "buildCommand": "node build.mjs",
  "outputDirectory": "build/pot-prototype",
  "functions": {
    "api/identify.js": {
      "maxDuration": 60
    },
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/push.js": {
      "maxDuration": 60
    },
    "api/remind.js": {
      "maxDuration": 30
    },
    "api/cron-remind.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-remind",
      "schedule": "0 6 * * *"
    }
  ]
}
